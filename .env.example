# ---------------------------------------------------------------------------
# Storyboard MCP -- configuration
#
# This server contains no AI model and calls no AI API. It is a deterministic
# tool layer. The connected client (Antigravity / Gemini) supplies all reasoning
# and generated content. There is deliberately no API key setting here, and
# adding one would be an architecture violation.
# ---------------------------------------------------------------------------

# Storage. `data/` holds the SQLite database and the derived template map;
# `artifacts/` holds generated .docx files and their storyboard state snapshots.
DB_PATH=./data/storyboard.db
ARTIFACT_DIR=./artifacts
COURSE_DIR=./courses
TEMPLATE_DIR=./templates

# ---------------------------------------------------------------------------
# Retrieval (deterministic BM25 over structurally scoped chunks -- no embeddings)
# ---------------------------------------------------------------------------
# Target chunk size in characters. Chunks split on heading and paragraph
# boundaries, so actual sizes vary around this.
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200
# Default number of chunks returned by search_course_content.
SEARCH_DEFAULT_LIMIT=8
SEARCH_MAX_LIMIT=50

# How much source text one storyboard module carries. Sized per unit rather than
# per chapter: every Part A row is a unit and is written about that unit, so each
# unit gets its own slice and no row is left without material to cite. Total
# volume then scales with a module's unit count rather than with how long its
# chapter happens to be -- chapters range from 9 to 145 chunks.
MODULE_CHUNKS_PER_UNIT=6
# Extra chunks of module-wide context on top of the per-unit slices: the chapter's
# opening pages and the Facilitator Guide's notes, which carry no unit code and are
# what Part A activities and Part C scripts draw on.
MODULE_CONTEXT_CHUNKS=10
# Ceiling on an internal scope listing, which is trimmed in document-priority
# order afterwards. Only has to exceed the largest chapter any course has.
MAX_SCOPE_CHUNKS=400

# Glossary lines each module contributes. The glossary is one alphabetical list at
# the end of the document, but it is gathered a module at a time so every term is
# written from the sources that use it and carries their citations.
GLOSSARY_TERMS_PER_MODULE=8

# ---------------------------------------------------------------------------
# Validation thresholds
#
# Content validation here is mechanical, not semantic: it checks that every
# generated field carries at least one citation, that each citation resolves to a
# real chunk in the correct course and chapter, and that the field's wording
# measurably overlaps the chunk it cites. It reports; it does not judge meaning.
# The client decides how to act on a report.
# ---------------------------------------------------------------------------
# Minimum share of a field's content words that must appear in its cited chunks
# for the citation to be considered supported. 0 disables the overlap check.
GROUNDING_MIN_OVERLAP=0.35
# Content words shorter than this are ignored when computing overlap.
GROUNDING_MIN_TOKEN_LENGTH=4

# After rendering, hand the .docx to Word once (via COM) so the table of contents
# holds real page numbers rather than resolving them on first open. Needs Word and
# Windows; where it is unavailable the render still succeeds and says so. Costs
# about ten seconds per document.
REFRESH_FIELDS=true

LOG_LEVEL=info
