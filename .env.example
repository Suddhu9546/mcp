# ---------------------------------------------------------------------------
# Storyboard MCP -- configuration
#
# This server contains no AI model and calls no AI API. It is a deterministic
# tool layer. The connected client (Antigravity / Gemini) supplies all reasoning
# and generated content. There is deliberately no API key setting here, and
# adding one would be an architecture violation.
# ---------------------------------------------------------------------------

# Storage. `data/` holds the SQLite database and the derived template map;
# `artifacts/` holds generated .docx files and their storyboard state snapshots.
DB_PATH=./data/storyboard.db
ARTIFACT_DIR=./artifacts
COURSE_DIR=./courses
TEMPLATE_DIR=./templates

# ---------------------------------------------------------------------------
# Transport -- how clients reach this server
# ---------------------------------------------------------------------------
# "stdio": the client spawns this process and speaks the protocol over its
# pipes. The local default; leave it alone for Antigravity, Gemini CLI or
# Claude Code driven from .mcp.json.
#
# "http": the process listens on a port and serves Streamable HTTP, so any
# number of clients connect to one URL. This is what a hosted deployment needs.
# `npm run start:http` and `npm run dev:http` pass --http instead, which does
# the same thing without setting a variable.
MCP_TRANSPORT=stdio

# Port to listen on in http mode. A hosting platform normally injects PORT
# itself and it must be honoured, or the service is unreachable; MCP_PORT is
# only the fallback for local runs.
MCP_PORT=8080

# Interface to bind. 0.0.0.0 rather than localhost, because a container's
# health check and router reach the process from outside the container.
MCP_HOST=0.0.0.0

# Path serving the MCP endpoint. /healthz is always served alongside it and
# reports the listener without touching the database.
MCP_PATH=/mcp

# DNS-rebinding protection: comma-separated Host and Origin values to accept.
# Left blank the protection is off, which is correct behind a platform router
# that has already validated the hostname. Set them when the process is exposed
# directly, e.g.
#   MCP_ALLOWED_HOSTS=cvc-mcp.onrender.com
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Bearer token required on the HTTP endpoint. Everything behind it -- all 35
# tools, and through them the whole indexed corpus -- is reachable by anyone who
# has this, so treat it as a password and keep it out of the repository.
#
# HTTP mode REFUSES TO START with neither this nor MCP_ALLOW_ANONYMOUS set, so a
# public endpoint cannot be left open by forgetting a variable. Minimum 16
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Irrelevant under stdio, where the client already owns the process it spawned.
MCP_AUTH_TOKEN=

# Several accepted tokens, comma separated. Use this to rotate without a gap
# (add the new one, move clients over, drop the old one) or to give a client its
# own token so it can be revoked alone. Merged with MCP_AUTH_TOKEN.
MCP_AUTH_TOKENS=

# Serve with no authentication whatsoever. Reasonable for a loopback dev run,
# never for a deployment -- it publishes every tool to anyone who can reach the
# port.
MCP_ALLOW_ANONYMOUS=false

# Public base URL of this service, e.g. https://cvc-mcp.onrender.com. The
# process cannot discover this itself -- it sits behind a router that terminates
# TLS -- and it is what turns a generated file into a link the user can open.
#
# Left empty, tools return only local file paths. That is correct for stdio: the
# .docx is already on the machine that asked for it.
MCP_PUBLIC_URL=

# Path prefix serving generated files, and how long a link stays valid.
#
# Links are signed and expiring rather than requiring the bearer token, because
# what finally opens one is a browser and a link cannot carry a header. The
# signature covers the path and the expiry, so a link grants exactly one file
# for a limited time -- but it IS a credential for that file while it lasts, so
# it will sit in browser history and in whatever chat it was pasted into.
MCP_DOWNLOAD_PATH=/files
MCP_DOWNLOAD_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Retrieval (deterministic BM25 over structurally scoped chunks -- no embeddings)
# ---------------------------------------------------------------------------
# Target chunk size in characters. Chunks split on heading and paragraph
# boundaries, so actual sizes vary around this.
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200
# Default number of chunks returned by search_course_content.
SEARCH_DEFAULT_LIMIT=8
SEARCH_MAX_LIMIT=50

# How much source text one storyboard module carries. Sized per unit rather than
# per chapter: every Part A row is a unit and is written about that unit, so each
# unit gets its own slice and no row is left without material to cite. Total
# volume then scales with a module's unit count rather than with how long its
# chapter happens to be -- chapters range from 9 to 145 chunks.
MODULE_CHUNKS_PER_UNIT=6
# Extra chunks of module-wide context on top of the per-unit slices: the chapter's
# opening pages and the Facilitator Guide's notes, which carry no unit code and are
# what Part A activities and Part C scripts draw on.
MODULE_CONTEXT_CHUNKS=10
# Ceiling on an internal scope listing, which is trimmed in document-priority
# order afterwards. Only has to exceed the largest chapter any course has.
MAX_SCOPE_CHUNKS=400

# Glossary lines each module contributes. The glossary is one alphabetical list at
# the end of the document, but it is gathered a module at a time so every term is
# written from the sources that use it and carries their citations.
GLOSSARY_TERMS_PER_MODULE=8

# ---------------------------------------------------------------------------
# Validation thresholds
#
# Content validation here is mechanical, not semantic: it checks that every
# generated field carries at least one citation, that each citation resolves to a
# real chunk in the correct course and chapter, and that the field's wording
# measurably overlaps the chunk it cites. It reports; it does not judge meaning.
# The client decides how to act on a report.
# ---------------------------------------------------------------------------
# Minimum share of a field's content words that must appear in its cited chunks
# for the citation to be considered supported. 0 disables the overlap check.
GROUNDING_MIN_OVERLAP=0.35
# Content words shorter than this are ignored when computing overlap.
GROUNDING_MIN_TOKEN_LENGTH=4

# After rendering, hand the .docx to Word once (via COM) so the table of contents
# holds real page numbers rather than resolving them on first open. Needs Word and
# Windows; where it is unavailable the render still succeeds and says so. Costs
# about ten seconds per document.
REFRESH_FIELDS=true

LOG_LEVEL=info
